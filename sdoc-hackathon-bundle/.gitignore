# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Testing and type-checking cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment variables and secrets
.env
.env.*
!.env.example
.streamlit/secrets.toml

# IDE settings
.vscode/
.idea/

# Operating-system files
.DS_Store
Thumbs.db

# Log files
*.log

# Generated dashboard output
output/*.json
output/*.csv
output/*.pdf

# Keep the output directory in Git
!output/.gitkeep

# Temporary files
tmp/
temp/
*.tmp

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# Build and packaging output
build/
dist/
*.egg-info/